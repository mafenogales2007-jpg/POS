{
  "info": {
    "_postman_id": "pos-api-ventas-brayan-trimestre-5",
    "name": "POS API - Módulo de Facturación y Ventas (Brayan)",
    "description": "Colección completa de pruebas y documentación de la API REST para el módulo de Ventas, Facturación transaccional, Descuentos supervisados, Anulación y Formas de Pago según la Arquitectura Camino B y el Plan de Trabajo Full-Stack.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token_cajero",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "cliente_id",
      "value": "654321000000000000000001",
      "type": "string"
    },
    {
      "key": "forma_pago_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "producto_id",
      "value": "654321000000000000000002",
      "type": "string"
    },
    {
      "key": "venta_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Formas de Pago (Nivel 1)",
      "description": "HU-07: Catálogo maestro de métodos de liquidación para el origen del dinero.",
      "item": [
        {
          "name": "Listar Formas de Pago (Checkout POS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set('forma_pago_id', json.data[0]._id);",
                  "    console.log('Forma de pago guardada automáticamente:', json.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/formas-de-pago",
              "host": ["{{base_url}}"],
              "path": ["formas-de-pago"]
            },
            "description": "Obtiene la lista de formas de pago activas (Efectivo, Tarjeta, Nequi, Daviplata, etc.) para alimentar el select de CheckoutPOS en React 19."
          }
        },
        {
          "name": "Crear Forma de Pago (Solo ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcionFormaDePago\": \"Transferencia Bancaria\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/formas-de-pago",
              "host": ["{{base_url}}"],
              "path": ["formas-de-pago"]
            },
            "description": "Registra un nuevo método de pago oficial (restringido a rol ADMIN)."
          }
        }
      ]
    },
    {
      "name": "02. Cobro Transaccional de Ventas (Nivel 4 y 5)",
      "description": "HU-08: Facturación de productos, cálculo automático de impuestos/totales y deducción atómica de inventario con Mongoose startSession.",
      "item": [
        {
          "name": "Registrar Venta Exitosa (React 19 Payload)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data && json.data._id) {",
                  "    pm.collectionVariables.set('venta_id', json.data._id);",
                  "    console.log('ID de la venta guardado automáticamente:', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"{{cliente_id}}\",\n  \"formaDePago\": \"{{forma_pago_id}}\",\n  \"subTotalVentas\": 50000,\n  \"descuento\": 0,\n  \"ivaVentas\": 9500,\n  \"totalVentas\": 59500,\n  \"items\": [\n    {\n      \"producto\": \"{{producto_id}}\",\n      \"cantidadVenta\": 2,\n      \"valorUnitarioVenta\": 25000,\n      \"subTotalVenta\": 50000,\n      \"ivaVenta\": 19,\n      \"totalVenta\": 59500\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ventas",
              "host": ["{{base_url}}"],
              "path": ["ventas"]
            },
            "description": "RF-07 y RNF-04: Registra la cabecera en VentasModel, crea los registros en DetalleVentaModel y descuenta existencias en una sola transacción atómica."
          }
        },
        {
          "name": "RF-08: Intento Descuento > 10% (Sin permiso ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"{{cliente_id}}\",\n  \"formaDePago\": \"{{forma_pago_id}}\",\n  \"subTotalVentas\": 100000,\n  \"descuento\": 15000,\n  \"ivaVentas\": 16150,\n  \"totalVentas\": 101150,\n  \"items\": [\n    {\n      \"producto\": \"{{producto_id}}\",\n      \"cantidadVenta\": 2,\n      \"valorUnitarioVenta\": 50000,\n      \"subTotalVenta\": 100000,\n      \"ivaVenta\": 19,\n      \"totalVenta\": 119000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ventas",
              "host": ["{{base_url}}"],
              "path": ["ventas"]
            },
            "description": "Prueba de la regla RF-08: Un descuento del 15% ($15.000 sobre $100.000) debe ser rechazado con 403 si el operador no es ADMIN."
          }
        },
        {
          "name": "RF-08: Venta con Descuento > 10% Autorizado por ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"{{cliente_id}}\",\n  \"formaDePago\": \"{{forma_pago_id}}\",\n  \"subTotalVentas\": 100000,\n  \"descuento\": 15000,\n  \"ivaVentas\": 16150,\n  \"totalVentas\": 101150,\n  \"items\": [\n    {\n      \"producto\": \"{{producto_id}}\",\n      \"cantidadVenta\": 2,\n      \"valorUnitarioVenta\": 50000,\n      \"subTotalVenta\": 100000,\n      \"ivaVenta\": 19,\n      \"totalVenta\": 119000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ventas",
              "host": ["{{base_url}}"],
              "path": ["ventas"]
            },
            "description": "Prueba de la regla RF-08: Venta con 15% de descuento autorizada exitosamente al operar con token ADMIN."
          }
        },
        {
          "name": "RNF-05: Rechazo por Stock Insuficiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"{{cliente_id}}\",\n  \"formaDePago\": \"{{forma_pago_id}}\",\n  \"subTotalVentas\": 25000000,\n  \"descuento\": 0,\n  \"ivaVentas\": 4750000,\n  \"totalVentas\": 29750000,\n  \"items\": [\n    {\n      \"producto\": \"{{producto_id}}\",\n      \"cantidadVenta\": 99999,\n      \"valorUnitarioVenta\": 25000,\n      \"subTotalVenta\": 2499975000,\n      \"ivaVenta\": 19,\n      \"totalVenta\": 2974970250\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/ventas",
              "host": ["{{base_url}}"],
              "path": ["ventas"]
            },
            "description": "RNF-05: Comprueba que la sesión transaccional aborte la venta si la cantidad excede el stock disponible, evitando existencias negativas."
          }
        }
      ]
    },
    {
      "name": "03. Consultas e Historial de Ventas",
      "description": "Consultas relacionales con populate de Tercero, Usuario (cajero) y FormaDePago.",
      "item": [
        {
          "name": "Listar Historial de Ventas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ventas",
              "host": ["{{base_url}}"],
              "path": ["ventas"]
            },
            "description": "Obtiene todas las ventas registradas ordenadas cronológicamente con populate completo."
          }
        },
        {
          "name": "Consultar Venta por ID con Detalles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ventas/{{venta_id}}",
              "host": ["{{base_url}}"],
              "path": ["ventas", "{{venta_id}}"]
            },
            "description": "Retorna la cabecera de la venta junto con el arreglo de sus DetalleVenta asociados."
          }
        },
        {
          "name": "Consultar Detalles de Venta Específica",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/detalles-venta?ventaId={{venta_id}}",
              "host": ["{{base_url}}"],
              "path": ["detalles-venta"],
              "query": [
                {
                  "key": "ventaId",
                  "value": "{{venta_id}}"
                }
              ]
            },
            "description": "Filtra directamente en la colección DetalleVentaModel los ítems asociados a una venta."
          }
        }
      ]
    },
    {
      "name": "04. Anulación Supervisada (RF-09)",
      "description": "HU-09: Cancelación de ventas supervisada por ADMIN con reingreso automático al stock.",
      "item": [
        {
          "name": "Anular Venta (Exclusivo ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ventas/{{venta_id}}/anular",
              "host": ["{{base_url}}"],
              "path": ["ventas", "{{venta_id}}", "anular"]
            },
            "description": "RF-09: Cambia el estadoVentas a 'Anulada' y devuelve automáticamente las cantidades vendidas al stock de cada producto."
          }
        },
        {
          "name": "Intento de Anular Venta siendo CAJERO (Rechazo 403)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cajero}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ventas/{{venta_id}}/anular",
              "host": ["{{base_url}}"],
              "path": ["ventas", "{{venta_id}}", "anular"]
            },
            "description": "Prueba de seguridad: Un operador con rol CAJERO no puede anular ventas (requiere autorización ADMIN)."
          }
        }
      ]
    }
  ]
}
